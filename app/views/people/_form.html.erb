<%= form_with model: person, class: "stack" do |f| %>
  <% if person.errors.any? %><p class="flash bad"><%= person.errors.full_messages.to_sentence %>.</p><% end %>
  <% if @relate_to && @as %>
    <input type="hidden" name="relate_to" value="<%= @relate_to.id %>"><input type="hidden" name="as" value="<%= @as %>">
    <p class="mut2">Adding <%= { "parent" => "a parent of", "child" => "a child of", "partner" => "a partner of" }[@as] %> <strong><%= @relate_to.display_name %></strong>.</p>
  <% end %>
  <div class="row">
    <label>First name <%= f.text_field :first_name, required: true, maxlength: 80 %></label>
    <label>Last name <%= f.text_field :last_name, maxlength: 120 %></label>
    <label>Maiden name <%= f.text_field :maiden_name, maxlength: 120 %></label>
    <label>Goes by <%= f.text_field :nickname, maxlength: 120 %></label>
  </div>
  <div class="row">
    <label>Born <%= f.date_field :birth_date %></label>
    <label>Died <%= f.date_field :death_date %></label>
    <label>Birthplace <%= f.text_field :birth_place %></label>
    <label>Work <%= f.text_field :occupation %></label>
  </div>
  <div class="row">
    <label><%= terms.Party %> <%= f.collection_select :household_id, current_family.households.order(:name), :id, :name, { include_blank: "(none)" } %></label>
    <label>Email <%= f.email_field :email %></label>
    <label>Phone <%= f.telephone_field :phone, maxlength: 30, placeholder: "(555) 555-0123" %></label>
    <label>Second phone <%= f.telephone_field :phone2, maxlength: 30 %></label>
  </div>
  <fieldset class="stack"><legend>Mailing address</legend>
    <p class="fine">Where this person gets mail: a campus box or a different address from their <%= terms.party %> is fine.</p>
    <div class="row">
      <label>Street <%= f.text_field :street1, maxlength: 120, autocomplete: "address-line1" %></label>
      <label>Street, line 2 <%= f.text_field :street2, maxlength: 120, autocomplete: "address-line2" %></label>
    </div>
    <div class="row">
      <label>City <%= f.text_field :city, maxlength: 120 %></label>
      <label>State <%= f.text_field :state, maxlength: 40 %></label>
      <label>Zip <%= f.text_field :zip, maxlength: 12, autocomplete: "postal-code" %></label>
    </div>
  </fieldset>
  <label>Notes <%= f.text_area :notes, rows: 4, maxlength: 4000 %></label>
  <label class="chk"><%= f.check_box :hide_details %> <%= terms.kids_note %></label>
  <%= f.submit(person.new_record? ? "Add person" : "Save") %>
<% end %>
