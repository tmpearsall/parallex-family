<% content_for :title, "Access · #{current_family.name}" %>
<h1>Access</h1>
<% if ApplicationMailer.configured? %>
<p class="mut2">You are an organizer. Invite <%= terms.invitees %> here: each gets a one-time link (good for 7 days), emailed to them if you leave the box ticked, and shown here so you can copy it too. Paste several addresses to invite several people at once.</p>
<% else %>
<p class="mut2">You are an organizer. Invite <%= terms.invitees %> here: each gets a one-time link (good for 7 days) that you copy and send. Email sending is not connected yet (see Email below). Paste several addresses to make several links at once.</p>
<% end %>
<%= form_with scope: :invite, url: members_path, class: "stack" do |f| %>
  <label>Email addresses (one or more) <%= f.text_area :emails, rows: 3, required: true, value: @prefill&.email, placeholder: "cousin@example.com, aunt@example.com" %></label>
  <div class="row">
    <label>Which person is this? (one email only) <%= f.collection_select :person_id, @people, :id, :display_name, { include_blank: "(not linked)", selected: @prefill&.id } %></label>
    <label>Role <%= f.select :role, [["Member", "member"], ["Organizer", "organizer"]] %></label>
  </div>
  <fieldset class="stack"><legend>Not in the list? Add them here</legend>
    <p class="fine">Type their name (one email only) and they are added as a person, so you don't have to leave this page.</p>
    <div class="row">
      <label>First name <%= f.text_field :new_first_name, maxlength: 80 %></label>
      <label>Last name <%= f.text_field :new_last_name, maxlength: 120 %></label>
    </div>
    <% if terms.tree? %>
      <div class="row">
        <label>This person is the <%= f.select :relation, [["(no relation recorded)", ""], ["child", "child"], ["parent", "parent"], ["partner", "partner"]] %></label>
        <label>of <%= f.collection_select :related_to_id, current_family.people.by_name, :id, :display_name, { include_blank: "(choose)", selected: current_membership.person_id } %></label>
      </div>
    <% end %>
  </fieldset>
  <% if ApplicationMailer.configured? %>
    <label class="chk"><%= f.check_box :send_email, { checked: true }, "1", "0" %> Email each person their link</label>
  <% else %>
    <p class="fine">Email sending is not set up yet: you get a link for each person to send yourself.</p>
  <% end %>
  <%= f.submit "Create links" %>
<% end %>

<h2>Send a reminder</h2>
<p class="mut2">Write a message to <%= terms.the_people %> now, outside the daily digest. <a href="<%= new_announcement_path %>">Send a reminder</a> · <a href="<%= announcements_path %>">Messages already sent</a></p>
<p class="mut2">Need answers, such as which dates work? <a href="<%= new_survey_path %>">Create a survey</a> and email everyone a personal link · <a href="<%= surveys_path %>">Your surveys</a></p>

<h2>Email</h2>
<% if ApplicationMailer.configured? %>
  <p class="mut2">Email is on. Messages are sent as <strong><%= ApplicationMailer.from_address %></strong> <%= ApplicationMailer.settings_summary %>.</p>
  <%= button_to "Send myself a test email", test_email_path, method: :post, class: "link" %>
<% else %>
  <p class="mut2">Email sending is not connected yet, so invitations are links you copy and send, and no reminder emails go out. This site cannot see all of the settings it needs:</p>
  <ul class="list">
    <% MailSettings.checklist.each do |name, set| %><li><code><%= name %></code> <span class="tag <%= set ? 'pub' : 'dis' %>"><%= set ? "found" : "missing" %></span></li><% end %>
  </ul>
  <p class="fine">Add the missing ones to this service in Render (directly, or through the shared environment group, which must be linked to this service). The site restarts when they change.</p>
<% end %>

<h2><%= terms.Group %> name</h2>
<%= form_with url: settings_path, method: :patch, class: "row" do |f| %>
  <label>Shown at the top of every page <%= f.text_field :name, value: current_family.name, maxlength: 80, required: true %></label><%= f.submit "Rename" %>
<% end %>

<h2>In this <%= terms.group %></h2>
<div class="scroll"><table class="t"><tr><th>Name</th><th>Email</th><th><%= terms.person_col %></th><th>Role</th><th></th></tr>
<% @memberships.each do |m| %>
  <tr><td><%= m.user.label %></td><td><%= m.user.email %></td><td><%= m.person&.display_name %></td><td><%= m.role %></td>
    <td><% if m.user_id != current_user.id %>
      <%= button_to (m.organizer? ? "Make member" : "Make organizer"), member_path(m, role: (m.organizer? ? "member" : "organizer")), method: :patch, class: "link", form: { class: "inline" } %>
      <%= button_to "Remove", member_path(m), method: :delete, class: "link", form: { class: "inline" }, data: { turbo_confirm: "Remove #{m.user.label} from this #{terms.group}?" } %>
    <% end %></td></tr>
<% end %></table></div>

<h2>Waiting to accept</h2>
<% if @invitations.empty? %><p class="mut2">No pending invitations.</p><% else %>
  <ul class="list"><% @invitations.each do |i| %>
    <li><%= i.email %> <span class="mut2">· <%= i.role %> · expires <%= i.expires_at.strftime("%b %-d") %><%= " · for #{i.person.display_name}" if i.person %></span>
      <span class="mut2"><%= i.emailed_at ? "· emailed #{i.emailed_at.strftime('%b %-d')}" : "" %><%= " · email failed" if i.email_error %></span>
      <%= button_to (ApplicationMailer.configured? ? "Resend" : "New link"), resend_member_path(i), method: :post, class: "link", form: { class: "inline" } %>
      <%= button_to "Withdraw", revoke_member_path(i), method: :delete, class: "link", form: { class: "inline" } %></li>
  <% end %></ul>
  <p class="fine">Resend makes a fresh link and withdraws the old one.</p>
<% end %>
