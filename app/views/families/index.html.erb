<% content_for :title, "Your families and groups" %>
<h1>Your families and groups</h1>
<% if @memberships.empty? %>
  <p>You are not in a group yet. Ask an organizer to invite you; they will give you a link.</p>
<% else %>
  <ul class="list"><% @memberships.each do |m| %>
    <li><a href="<%= family_home_path(family: m.family.slug) %>"><%= m.family.name %></a> <span class="mut2"><%= m.role %></span></li>
  <% end %></ul>
<% end %>
