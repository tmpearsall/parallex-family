<% content_for :title, "#{terms.Parties} · #{current_family&.name || Instance.app_name}" %>
<h1><%= terms.Parties %></h1>
<p><a href="<%= new_household_path %>">Add a <%= terms.party %></a></p>
<ul class="list"><% @households.each do |h| %>
  <li><a href="<%= household_path(h) %>"><%= h.name %></a> <span class="mut2"><%= h.place %> &middot; <%= pluralize(h.people.size, "person") %></span></li>
<% end %></ul>
<% if @households.empty? %><p>No <%= terms.parties %> yet. RSVPs are taken by <%= terms.party %>.</p><% end %>
