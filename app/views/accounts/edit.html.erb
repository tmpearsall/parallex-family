<% content_for :title, "Your name · #{current_family&.name || Instance.app_name}" %>
<h1>Your display name</h1>
<%= form_with url: account_path, method: :patch, local: true, html: { class: "auth" } do |f| %>
  <label for="name">Display name</label>
  <%= text_field_tag :name, current_user.name, id: "name", maxlength: 60, required: true, autocomplete: "nickname" %>
  <p class="fine">This is the name other members see in the forum and on tasks. Use a name, never a password. Your email is never shown to other members.</p>
  <%= submit_tag "Save" %>
<% end %>
