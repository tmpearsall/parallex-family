<% content_for :title, "#{terms.Events} · #{current_family&.name || Instance.app_name}" %>
<h1><%= terms.Events %></h1>
<% if organizer? %><p><a href="<%= new_reunion_path %>">New <%= terms.event %></a></p><% end %>
<ul class="list"><% @reunions.each do |r| %>
  <li><a href="<%= reunion_path(r) %>"><%= r.title %></a> <span class="mut2"><%= r.starts_on ? r.starts_on.strftime("%B %-d, %Y") : "date not set" %></span></li>
<% end %></ul>
