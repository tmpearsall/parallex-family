<% content_for :title, "#{@reunion.title} · #{current_family&.name || Instance.app_name}" %>
<p class="fine"><a href="<%= reunions_path %>">&larr; <%= terms.Events %></a><% if organizer? %> &middot; <a href="<%= edit_reunion_path(@reunion) %>">Edit</a><% end %></p>
<h1><%= @reunion.title %></h1>
<p class="mut2">
  <%= @reunion.dated? ? [@reunion.starts_on.strftime("%A, %B %-d, %Y"), (@reunion.ends_on ? "to #{@reunion.ends_on.strftime('%B %-d')}" : nil)].compact.join(" ") : "Date not set yet" %>
  <% if @reunion.location_name.present? %>&middot; <%= @reunion.location_name %><% end %>
  <% if @reunion.address.present? %>&middot; <%= @reunion.address %><% end %>
  <% if @reunion.rsvp_by %>&middot; please answer by <%= @reunion.rsvp_by.strftime("%B %-d") %><% end %>
</p>
<%= simple_format(h(@reunion.description)) if @reunion.description.present? %>

<h2 id="dates">Dates</h2>
<% if @reunion.date_options.empty? %><p class="mut2">No dates proposed yet.</p><% else %>
  <div class="scroll"><table class="t"><tr><th>Proposed</th><th>Yes</th><th>Maybe</th><th>No</th><th>Your vote</th></tr>
    <% @reunion.date_options.each do |o| t = o.tally; mine = @my_votes[o.id] %>
      <tr><td><%= o.starts_on.strftime("%a %b %-d") %><%= o.ends_on ? " – #{o.ends_on.strftime('%a %b %-d')}" : "" %> <span class="mut2"><%= o.note %></span></td>
        <td><%= t["yes"] %></td><td><%= t["maybe"] %></td><td><%= t["no"] %></td>
        <td><% DateVote::ANSWERS.each do |a| %><%= button_to a.capitalize, vote_reunion_date_option_path(@reunion, o, answer: a), method: :post, class: "link", form: { class: "inline" }, style: (mine&.answer == a ? "font-weight:700;text-decoration:underline" : "") %><% end %>
          <% if organizer? %><%= button_to "remove", reunion_date_option_path(@reunion, o), method: :delete, class: "link", form: { class: "inline" }, data: { turbo_confirm: "Remove this date and its votes?" } %><% end %></td></tr>
    <% end %></table></div>
<% end %>
<% if organizer? %>
  <%= form_with model: DateOption.new, url: reunion_date_options_path(@reunion), class: "row" do |f| %>
    <label>Propose a date <%= f.date_field :starts_on, required: true %></label><label>to (optional) <%= f.date_field :ends_on %></label><label>Note <%= f.text_field :note, placeholder: "Memorial Day weekend" %></label><%= f.submit "Add date" %>
  <% end %>
<% end %>

<h2 id="rsvp">Who is coming</h2>
<div class="grid">
  <div class="card"><div class="stat"><%= @headcount[:adults] + @headcount[:children] %></div><div class="statl"><%= @headcount[:adults] %> adults, <%= @headcount[:children] %> children, <%= pluralize(@headcount[:households], terms.party) %></div></div>
  <div class="card"><div class="stat"><%= @waiting.size %></div><div class="statl"><%= @waiting.size == 1 ? terms.party : terms.parties %> <%= @waiting.size == 1 ? "has" : "have" %> not answered<%= " · #{@headcount[:maybe_households]} maybe" if @headcount[:maybe_households] > 0 %></div></div>
</div>
<% if @households.empty? %><p class="mut2">Add <%= terms.parties %> first; RSVPs are taken by <%= terms.party %>. <a href="<%= new_household_path %>">Add one</a>.</p><% else %>
  <div class="scroll"><table class="t"><tr><th><%= terms.Party %></th><th>Answer</th><th>People</th><th>Needs</th><th>Answered by</th><th></th></tr>
  <% @households.each do |h| r = @rsvps[h.id] %>
    <tr><td><a href="<%= household_path(h) %>"><%= h.name %></a></td>
      <td><% if r %><span class="pill <%= r.status %>"><%= r.label %></span><% else %><span class="mut2">no answer</span><% end %></td>
      <td><%= r&.status == "attending" ? "#{r.adults} + #{r.children}" : "" %></td>
      <td><%= [(r&.lodging_needed ? "lodging" : nil), r&.dietary.presence].compact.join("; ") %></td>
      <td class="mut2"><%= r&.answered_by&.label %></td>
      <td><a href="#answer">answer</a></td></tr>
  <% end %></table></div>
  <details id="answer" open><summary>Answer for a <%= terms.party %></summary>
    <%= form_with url: reunion_rsvps_path(@reunion), scope: :rsvp, class: "stack" do |f| %>
      <label><%= terms.Party %> <%= f.collection_select :household_id, @households, :id, :name, { selected: @my_household&.id } %></label>
      <label>Answer <%= f.select :status, Rsvp::STATUSES.map { |s| [Rsvp::LABELS[s], s] } %></label>
      <div class="row"><label>Adults <%= f.number_field :adults, min: 0, max: 50, value: 0 %></label><label>Children <%= f.number_field :children, min: 0, max: 50, value: 0 %></label></div>
      <div class="row"><label>Arriving <%= f.date_field :arrival_on %></label><label>Leaving <%= f.date_field :departure_on %></label></div>
      <label class="chk"><%= f.check_box :lodging_needed %> We need help finding a place to stay</label>
      <label>Food needs (allergies, diets) <%= f.text_area :dietary, rows: 2 %></label>
      <label>Anything else <%= f.text_area :notes, rows: 2 %></label>
      <%= f.submit "Save answer" %>
    <% end %>
  </details>
<% end %>

<h2 id="tasks">What we need</h2>
<ul class="list">
  <% @tasks.each do |t| %>
    <li><span style="<%= 'text-decoration:line-through;color:var(--mut)' if t.done %>"><%= t.title %></span>
      <% if t.details.present? %><span class="mut2">— <%= t.details %></span><% end %>
      <span class="mut2">· <%= t.claimed_by ? "claimed by #{t.claimed_by.label}" : "nobody yet" %></span>
      <% if t.claimed_by_id.nil? %><%= button_to "I'll do it", claim_reunion_task_path(@reunion, t), method: :patch, class: "link", form: { class: "inline" } %>
      <% elsif t.claimed_by_id == current_user.id %><%= button_to (t.done ? "Not done" : "Done"), toggle_reunion_task_path(@reunion, t), method: :patch, class: "link", form: { class: "inline" } %><%= button_to "Release", unclaim_reunion_task_path(@reunion, t), method: :patch, class: "link", form: { class: "inline" } %><% end %>
      <% if organizer? || t.claimed_by_id.nil? %><%= button_to "remove", reunion_task_path(@reunion, t), method: :delete, class: "link", form: { class: "inline" }, data: { turbo_confirm: "Remove this?" } %><% end %></li>
  <% end %>
</ul>
<%= form_with model: Task.new, url: reunion_tasks_path(@reunion), class: "row" do |f| %>
  <label>Add something we need <%= f.text_field :title, required: true, placeholder: "Someone to bring a grill" %></label><label>Details <%= f.text_field :details %></label><%= f.submit "Add" %>
<% end %>

<h2>Forum</h2>
<% if @topics.empty? %><p class="mut2">No topics about this <%= terms.event %> yet.</p><% else %><ul class="list"><% @topics.each do |t| %><li><a href="<%= board_topic_path(t) %>"><%= t.title %></a></li><% end %></ul><% end %>
<p class="fine"><a href="<%= board_path(reunion_id: @reunion.id) %>">Start a forum topic about this <%= terms.event %></a></p>
