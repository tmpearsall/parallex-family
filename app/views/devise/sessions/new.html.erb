<% content_for :title, "Sign in · Family" %>
<h1>Sign in</h1>
<%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "auth" }) do |f| %>
  <%= f.label :email %><%= f.email_field :email, autofocus: true, autocomplete: "email" %>
  <%= f.label :password, for: "password" %><%= f.password_field :password, autocomplete: "current-password", id: "password" %>
  <label class="chk"><input type="checkbox" id="show"> Show what I type</label>
  <label class="chk"><%= f.check_box :remember_me %> Keep me signed in</label>
  <%= f.submit "Sign in" %>
<% end %>
<p class="fine">Accounts are issued by invitation. If you need access or a new link, ask whoever invited you.</p>
<script>
  (function () {
    var pw = document.getElementById("password"), show = document.getElementById("show");
    show.addEventListener("change", function () { pw.type = show.checked ? "text" : "password"; });
  })();
</script>
