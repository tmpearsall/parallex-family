<% content_for :title, current_family&.name || Instance.app_name %>
<% if @steps.present? && @steps.any? { |st| !st[:done] } %>
  <div class="card">
    <h2 style="margin-top:0">Getting started</h2>
    <ul class="list">
      <% @steps.each do |st| %>
        <li><%= st[:done] ? "✓" : "○" %> <strong><%= st[:text] %></strong><% unless st[:done] %> <span class="mut2">· <%= st[:hint] %></span> <a href="<%= st[:path] %>"><%= st[:link] %></a><% end %></li>
      <% end %>
    </ul>
    <p class="fine">Not sure what something does? <a href="<%= help_path %>">How this site works</a>.</p>
  </div>
<% end %>
<% if @reunion %>
  <h1><%= @reunion.title %></h1>
  <p class="mut2">
    <%= @reunion.dated? ? [@reunion.starts_on.strftime("%A, %B %-d, %Y"), (@reunion.ends_on ? "to #{@reunion.ends_on.strftime('%B %-d')}" : nil)].compact.join(" ") : "Date not set yet" %>
    <% if @reunion.location_name.present? %>&middot; <%= @reunion.location_name %><% end %>
  </p>
  <div class="grid">
    <div class="card"><div class="stat"><%= @headcount[:adults] + @headcount[:children] %></div><div class="statl">people coming (<%= @headcount[:adults] %> adults, <%= @headcount[:children] %> children) from <%= pluralize(@headcount[:households], terms.party) %></div></div>
    <div class="card"><div class="stat"><%= @headcount[:maybe_households] %></div><div class="statl"><%= terms.parties %> maybe &middot; <%= @headcount[:declined] %> can't come</div></div>
  </div>
  <% if @my_household && @my_rsvp.nil? %>
    <p class="card"><strong>Your <%= terms.party %> (<%= @my_household.name %>) has not answered yet.</strong> <a href="<%= reunion_path(@reunion) %>#rsvp">RSVP</a></p>
  <% end %>
  <% if @unvoted.any? %>
    <p class="card">You have not voted on <%= pluralize(@unvoted.size, "proposed date") %>. <a href="<%= reunion_path(@reunion) %>#dates">Vote</a></p>
  <% end %>
  <% if @open_tasks.any? %>
    <h2>Still needed</h2>
    <ul class="list"><% @open_tasks.each do |t| %><li><%= t.title %> <span class="mut2"><%= t.claimed_by ? "· #{t.claimed_by.label}" : "· nobody yet" %></span></li><% end %></ul>
    <p class="fine"><a href="<%= reunion_path(@reunion) %>#tasks">All tasks</a></p>
  <% end %>
<% else %>
  <h1><%= current_family.name %></h1>
  <p>No <%= terms.event %> is planned yet.<% if organizer? %> <a href="<%= new_reunion_path %>">Start one</a>.<% end %></p>
<% end %>

<h2>From the board</h2>
<% if @topics.empty? %><p class="mut2">Nothing yet. <a href="<%= board_path %>">Start a topic.</a></p><% else %>
  <ul class="list boardlist"><% @topics.each do |t| %><li><a class="ttl" href="<%= board_topic_path(t) %>"><%= t.title %></a> <span class="mut2"><%= t.user.label %> &middot; <%= time_ago_in_words(t.created_at) %> ago</span></li><% end %></ul>
<% end %>
