<% content_for :title, "Members · #{current_family.name}" %>
<h1>Members</h1>
<p class="mut2">Everyone with an account in <%= current_family.name %>, by the name they chose. Posts, answers and edits across the site show these names.</p>
<ul class="list">
  <% @memberships.each do |m| %>
    <li><strong><%= m.user.label %></strong>
      <% if m.organizer? %><span class="tag pub">Organizer</span><% end %>
      <% if m.person %><span class="mut2"> · <%= terms.person_col.downcase %> <a href="<%= person_path(m.person) %>"><%= m.person.display_name %></a></span><% else %><span class="mut2"> · <%= terms.no_tree_link %></span><% end %>
      <% if organizer? %><span class="mut2"> · <%= m.user.email %></span><% end %></li>
  <% end %>
</ul>
<% if organizer? %><p class="fine"><a href="<%= members_path %>">Invite someone or manage access</a></p><% end %>
<h2>Reminder emails</h2>
<p class="mut2">Reminders for the <%= terms.event %>: RSVP deadlines, dates to vote on, what you said you would bring, and the days before it starts. One short email a day at most.</p>
<%= button_to (current_membership.email_reminders ? "Turn reminder emails off" : "Turn reminder emails on"), my_reminders_path(on: current_membership.email_reminders ? "0" : "1"), method: :patch, class: "link" %>

<h2><%= terms.listed_no_account %></h2>
<% if @without_account.empty? %><p class="mut2"><%= terms.everyone_listed %></p><% else %>
  <p><%= safe_join(@without_account.map { |p| link_to(p.display_name, person_path(p)) }, ", ") %></p>
  <% if organizer? %><p class="fine">Open a person's page and use "Invite … to this site" to give them one.</p><% end %>
<% end %>
